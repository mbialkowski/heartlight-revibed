const POLISH := {"ą": "A", "ć": "C", "ę": "E", "ł": "L", "ń": "N", "ó": "O", "ś": "S", "ź": "Z",
		"ż": "Z", "Ą": "A", "Ć": "C", "Ę": "E", "Ł": "L", "Ń": "N", "Ó": "O", "Ś": "S", "Ź": "Z",
		"Ż": "Z"}
const ALLOWED := "abcdefghijklmnopqrstuvwxyz0123456789:. "

static var lang := "pl"


static func get_text(key: String) -> String:
	return T.get(lang, T["pl"]).get(key, T["en"].get(key, key))


static func glyph_text(s: String) -> String:
	"""Polish letters -> the font's capitals, other unsupported characters -> space"""
	var out := ""
	for c in s:
		if POLISH.has(c):
			out += POLISH[c]
		else:
			var l := c.to_lower()
			out += l if ALLOWED.contains(l) else " "
	return out
